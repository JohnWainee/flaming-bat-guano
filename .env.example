# Azure OpenAI (all compute stays in your Azure tenant)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ServiceNow
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_AUTH_METHOD=basic  # or oauth
SNOW_USERNAME=api-service-account
SNOW_PASSWORD=your-password
# OAuth (if SNOW_AUTH_METHOD=oauth):
# SNOW_CLIENT_ID=your-client-id
# SNOW_CLIENT_SECRET=your-client-secret

# Redis
REDIS_URL=redis://redis:6379
CONVERSATION_TTL_SECONDS=3600

# Qdrant
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=optional-if-auth-enabled

# Email (choose IMAP or EWS)
EMAIL_TYPE=imap
EMAIL_HOST=mail.yourcompany.com
EMAIL_PORT=993
EMAIL_USERNAME=snow-intake@yourcompany.com
EMAIL_PASSWORD=your-password
EMAIL_USE_SSL=true
EMAIL_INBOX_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
# EWS only (EMAIL_TYPE=ews). Leave EWS_SERVER empty to use Autodiscover.
# EWS_PRIMARY_SMTP_ADDRESS defaults to EMAIL_USERNAME if unset.
EWS_SERVER=
EWS_PRIMARY_SMTP_ADDRESS=
EWS_AUTH_TYPE=NTLM

# Azure Bot Service (for Teams integration)
MICROSOFT_APP_ID=your-bot-app-id
MICROSOFT_APP_PASSWORD=your-bot-app-password

# Internal service URLs
ORCHESTRATOR_URL=http://orchestrator:8000
